# Daniyar AI V4
PORT=3000
HOST=0.0.0.0

# Providers: openrouter | ollama | anthropic
AI_PROVIDER=openrouter

# Recommended free route. OpenRouter chooses a compatible free model automatically.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Daniyar AI

# Local fallback
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Legacy provider support
ANTHROPIC_API_KEY=
DANIYAR_MODEL=

# Terminal safety
ALLOW_SHELL=true
